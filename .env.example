# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Facebook Messenger API Credentials (ApartmentPro Official Page ID: 1298546226679849, Meta App ID: 3246715018859879)
# Get these from the Facebook Developer Console under Messenger API settings.
FACEBOOK_PAGE_ID="1298546226679849"
FACEBOOK_APP_ID="3246715018859879"
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Firebase Web Client Configuration (Live Firestore Connectivity)
FIREBASE_API_KEY="AIzaSyB-xnApP91609agpMBhPPtHPaC5MB4Sh08"
FIREBASE_APP_ID="1:444816417263:web:ece8278909a1cfce47161a"
FIREBASE_AUTH_DOMAIN="gen-lang-client-0439520113.firebaseapp.com"
FIREBASE_MESSAGING_SENDER_ID="444816417263"

# Firebase & Firestore Configuration (Production Persistence)
FIREBASE_PROJECT_ID="gen-lang-client-0439520113"
FIREBASE_DATABASE_ID="ai-studio-apartmentpro-4ddedeef-b64f-41bb-85a6-1593d7fc4f55"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0439520113.firebasestorage.app"
# Optional Service Account (if using Admin SDK)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=



# Manual Messenger payment channels (set real values in Vercel/Cloud Run env only; never commit secrets)
APARTMENTPRO_GCASH_NAME=ApartmentPro Property Management
APARTMENTPRO_GCASH_NUMBER=
APARTMENTPRO_GCASH_QR_URL=
APARTMENTPRO_BANK_NAME=
APARTMENTPRO_BANK_ACCOUNT_NAME=ApartmentPro Property Management
APARTMENTPRO_BANK_ACCOUNT_NUMBER=
APARTMENTPRO_BANK_QR_URL=

# Security: secret used to sign admin-only payment verification sessions
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
